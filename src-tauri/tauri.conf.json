{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitshop Plus",
  "version": "../package.json",
  "identifier": "com.skyeautomotives.pitstopplus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5182",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pitshop Plus",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#F1F4F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Skye Automotives",
    "shortDescription": "Repair billing for automobile workshops",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Pitshop Plus",
        "displayLanguageSelector": false
      }
    },
    "copyright": "\u00a9 Skye Automotives"
  }
}
