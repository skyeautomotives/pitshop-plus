{
  "name": "pitstop-plus",
  "private": true,
  "version": "0.11.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin-demo": "vite --mode admin-demo --port 5190",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:desktop": "vite --mode desktop --port 5182 --strictPort",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "build:android": "tsc --noEmit && vite build --mode android",
    "tauri": "tauri",
    "android:sync": "npm run build:android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.58.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dexie": "^4.4.6",
    "html2canvas-pro": "2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "description": "Pitshop Plus: repair billing for automobile workshops, by Skye Automotives"
}
